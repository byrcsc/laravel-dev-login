# Environment for the workbench demo app.
#
# Every `vendor/bin/testbench` invocation copies this file into the Testbench
# skeleton as `.env`, and the copy routinely outlives the command that made it.
# The package test suite boots against that same skeleton, so these values have
# to be safe for `composer test` as well as for the demo.
#
# No `DEV_LOGIN_*` variable is set here, on purpose. It would reach the test
# suite through that same stranded copy, and a suite asserting the shipped
# defaults would then be asserting the demo's settings instead. The demo turns
# the package on in its own service provider, where only the demo sees it.
#
# `composer clear` removes the stranded copy.

APP_ENV=local
APP_DEBUG=true

# Fixed rather than generated: the demo serves the dev login page over HTTP,
# and a Laravel application with no key fails every request before it reaches a
# controller. It protects nothing - this app holds two invented users on a
# throwaway SQLite file - so it is checked in on purpose, and nothing real
# should ever be encrypted with it.
APP_KEY=base64:0bT1qCNpHECr5X4gN0DYxUwZ+ph4NKtEsHzGXf9c8fQ=

# `localhost` is on the shipped allowed-hosts list, which is what
# `testbench serve` binds to. Point this somewhere else and the demo's page
# 404s, which is the host gate doing its job.
APP_URL=http://localhost:8000

DB_CONNECTION=sqlite

QUEUE_CONNECTION=sync

CACHE_STORE=array

# Not `array`: the package drives Laravel's session guard, so a login that
# does not survive the redirect is not a login. This is the one driver choice
# in the demo that is load-bearing.
SESSION_DRIVER=file
